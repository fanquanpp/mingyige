{"songId":"1979007503","title":"一半一半","lines":[{"t":24.32,"text":"时间的微风吹过"},{"t":26.96,"text":"缓缓拂过了耳畔"},{"t":29.85,"text":"你的容颜一直悄悄改变"},{"t":32.47,"text":"离去太久才发觉"},{"t":35.3,"text":"回忆里面多少片段"},{"t":37.59,"text":"还能一一浮现在脑海"},{"t":40.43,"text":"想要再重来 回到年少的姿态"},{"t":43.64,"text":"你的白发也不再"},{"t":46.29,"text":"生命的短暂 生活的阻碍"},{"t":48.55,"text":"已经逝去的五分之三"},{"t":51.61,"text":"还有多少安排 有多少期待"},{"t":54.04,"text":"过去的梦何时捡起来"},{"t":57.05,"text":"年轻的牵绊 老去的无奈"},{"t":59.71,"text":"生命重复着因果循环"},{"t":62.51,"text":"还有谁的身影能永远如此的伟岸"},{"t":68.13,"text":"你的生命给了我一半"},{"t":70.82,"text":"你的爱也给了我一半"},{"t":73.51,"text":"夏天不懂冬日的严寒"},{"t":76.28,"text":"未曾想过人生的辛酸"},{"t":78.97,"text":"曾经有过多少的遗憾"},{"t":81.71,"text":"最后全都微笑着释然"},{"t":84.58,"text":"是否爱就是要被他人欺诈未来"},{"t":90.07,"text":"却不会悔改"},{"t":112.86,"text":"没有任何的不凡也没有夺目光彩"},{"t":117.89,"text":"我却明白你的意义所在"},{"t":120.86,"text":"别人都无法替代"},{"t":123.64,"text":"就算有时 产生几许不快"},{"t":126.5,"text":"你也很快就抛开"},{"t":128.83,"text":"虽然很平淡 没有多少的波澜"},{"t":132.01,"text":"却想时间过更慢"},{"t":134.55,"text":"生命的短暂 生活的阻碍"},{"t":137.02,"text":"已经逝去的五分之三"},{"t":139.82,"text":"还有多少安排 有多少期待"},{"t":142.22,"text":"过去的梦何时捡起来"},{"t":145.24,"text":"年轻的牵绊 老去的无奈"},{"t":147.87,"text":"生命重复着因果循环"},{"t":150.69,"text":"还有谁的身影能永远如此的伟岸"},{"t":156.4,"text":"无论我选择何种未来"},{"t":159.15,"text":"无论你心中如何不安"},{"t":161.66,"text":"最后还是放弃了愤慨"},{"t":164.29,"text":"相信我已能独自承担"},{"t":167.18,"text":"就算脾气总是特别坏"},{"t":170.19,"text":"就算整天抱怨着不满"},{"t":172.74,"text":"却也怎么都无法放弃这孤独港湾"},{"t":189.53,"text":"年轻的牵绊 老去的无奈"},{"t":192.09,"text":"生命重复着因果循环"},{"t":194.91,"text":"还有谁的身影能永远如此的伟岸"},{"t":200.69,"text":"你的生命给了我一半"},{"t":203.08,"text":"你的爱也给了我一半"},{"t":205.98,"text":"夏天不懂冬日的严寒"},{"t":208.63,"text":"未曾想过人生的辛酸"},{"t":211.35,"text":"曾经有过多少的遗憾"},{"t":214.17,"text":"最后全都微笑着释然"},{"t":216.82,"text":"谢谢你让我成为最幸福的小孩"},{"t":222.65,"text":"感谢你的爱"}]}