{"songId":"2010064355","title":"视线网","lines":[{"t":20.43,"text":"“纯白世界静谧"},{"t":23.53,"text":"孤独渺小深不见底"},{"t":27.83,"text":"蜷缩的声音"},{"t":30.48,"text":"并不会被在意"},{"t":34.52,"text":"他们眼中的你"},{"t":37.09,"text":"像太精巧剔透玻璃"},{"t":41.86,"text":"说你只需美丽"},{"t":44.29,"text":"不必思虑复杂命题"},{"t":48.61,"text":"若剥离精致外衣"},{"t":51.06,"text":"是否会留意最初那个你"},{"t":55.07,"text":"无数交织的视线里"},{"t":62.4,"text":"渴望谁带你逃离"},{"t":64.41,"text":"漩涡的中心 指责的话语"},{"t":68.06,"text":"被无关之人塑造的你"},{"t":75.05,"text":"惯将自我都藏匿着"},{"t":78.34,"text":"挣不脱偏执懦弱"},{"t":80.6,"text":"视线交叠着"},{"t":82.02,"text":"你的色泽你的轮廓"},{"t":85.26,"text":"早已被抉择"},{"t":88.71,"text":"或许斑驳 或许枯涸"},{"t":91.84,"text":"或许消失下一刻"},{"t":94.47,"text":"从此被淹没"},{"t":95.65,"text":"你并非无可替代的”"},{"t":99.48,"text":"如此对我说"},{"t":116.87,"text":"谁将重力悬空"},{"t":119.3,"text":"坠入一场蔚蓝的梦"},{"t":123.85,"text":"等待着一种"},{"t":126.53,"text":"不经意的重逢"},{"t":130.33,"text":"撞入一阵夜风"},{"t":132.96,"text":"湖泊倒影不再匆匆"},{"t":137.53,"text":"谁清澈眼眸中"},{"t":140.2,"text":"漾开熠熠繁星一捧"},{"t":144.67,"text":"或于某一天苏醒"},{"t":147.01,"text":"抖落轻盈羽翼满载晨曦"},{"t":151.31,"text":"在我们相逢视线里"},{"t":158.02,"text":"将我一生的意义"},{"t":160.45,"text":"赠予长夜谱作温柔梦境"},{"t":164.27,"text":"未来惊喜都藏好伏笔"},{"t":198.33,"text":"为所有视线涂抹上"},{"t":201.68,"text":"一片蔚蓝的颜色"},{"t":204.16,"text":"融化了苦涩"},{"t":205.4,"text":"听我为你唱这首歌"},{"t":208.95,"text":"请你靠近我"},{"t":212.07,"text":"不曾寥落 不曾干涸"},{"t":215.18,"text":"不曾遗忘下一刻"},{"t":218.08,"text":"从未被淹没"},{"t":219.35,"text":"“因为我始终会记得“"},{"t":222.61,"text":"如此对你说"}]}