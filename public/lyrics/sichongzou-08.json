{"songId":"3402764242","title":"唱给雅音宫羽","lines":[{"t":24.11,"text":"梦 依稀拂过淡青的霓裳"},{"t":31.18,"text":"天边有谁翻飞徴羽宫商"},{"t":39.88,"text":"听 山楂花蕾摇曳谁的笛章"},{"t":47.28,"text":"有谁能让我和着笛声 去轻声唱"},{"t":57.87,"text":"唱我拾起的梦想"},{"t":63.08,"text":"在天空中回荡"},{"t":66.71,"text":"就像那梦一样"},{"t":70.16,"text":"挥不散的迷茫"},{"t":73.09,"text":"绘 记忆中的衣装"},{"t":78.22,"text":"好像你在身旁"},{"t":82.4,"text":"可惜而你如今 在何方"},{"t":91.04,"text":"啊……"},{"t":102.45,"text":"看 山楂花瓣拨弄涟漪轻淌"},{"t":109.65,"text":"涟漪后浮现你的笑靥 嘴角轻扬"},{"t":118.11,"text":"唱 你给我的梦想"},{"t":123.11,"text":"在心底里徜徉"},{"t":126.93,"text":"就像那花一样"},{"t":130.56,"text":"总是笑着绽放"},{"t":133.56,"text":"你 是我最真模样"},{"t":138.53,"text":"从来不曾遗忘"},{"t":142.73,"text":"就像那花一样 不遗忘"},{"t":162.47,"text":"花落尽时候"},{"t":165.51,"text":"漫山都红透"},{"t":170.69,"text":"一粒一粒 串起那希望"},{"t":177.42,"text":"依著你肩膀 听笛声悠扬"},{"t":185.15,"text":"在你的耳边 轻轻去哼唱"},{"t":196.32,"text":"唱 你和我的梦想"},{"t":201.47,"text":"在手指尖绽放"},{"t":204.91,"text":"就像那风一样"},{"t":208.77,"text":"永远不会彷徨"},{"t":211.65,"text":"尝 糖葫芦的冰凉"},{"t":218.86,"text":"听风儿轻轻荡"},{"t":222.71,"text":"装作不经意间"},{"t":226.38,"text":"轻抚你脸庞"},{"t":229.23,"text":"你 眸子红得透亮"},{"t":234.44,"text":"别再透出悲伤"},{"t":238.66,"text":"我会一直陪在你身旁"},{"t":247.1,"text":"就算被世界遗忘"},{"t":254.67,"text":"我也会陪在你的身旁"},{"t":260.1,"text":"你身旁"}]}