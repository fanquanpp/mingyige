   "t": 0,
   "text": "冬扯云若柳絮飞"
  },
  {
   "t": 4.2,
   "text": "春采白雪作樱吹"
  },
  {
   "t": 8.4,
   "text": "夏剪玄青燕子尾"
  },
  {
   "t": 12.6,
   "text": "修成鬓梢美人眉"
  },
  {
   "t": 16.8,
   "text": "有大风自远方来"
  },
  {
   "t": 21,
   "text": "裁青天以补沧海"
  },
  {
   "t": 25.2,
   "text": "余波翻作白玉带"
  },
  {
   "t": 29.4,
   "text": "日月涌入怀"
