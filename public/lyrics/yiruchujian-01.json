{"songId":"1979007495","title":"心印","lines":[{"t":2.42,"text":"每一个梦都是个旋律"},{"t":8.62,"text":"漫天回忆该如何去聆听"},{"t":14.6,"text":"把心里面的思念传递给你"},{"t":20.97,"text":"让我们一起唱吧"},{"t":24.87,"text":"心中的歌"},{"t":51.53,"text":"旋律不经意诞生"},{"t":53.48,"text":"绽放的生命轻吻着灵魂"},{"t":57.46,"text":"叩开了一扇心门"},{"t":59.32,"text":"一段通往梦想的冒险旅程"},{"t":63.26,"text":"灵感轻舞的时分"},{"t":65.55,"text":"彩虹会把云端的路铺成"},{"t":69.66,"text":"音符在指间萦绕"},{"t":71.71,"text":"这一秒"},{"t":72.48,"text":"旋律简单又奇妙"},{"t":75.66,"text":"沿途的每个路标"},{"t":77.34,"text":"画一个惊叹号"},{"t":78.49,"text":"向云的"},{"t":79.29,"text":"另一端奔跑"},{"t":81.17,"text":"梦从来都不会渺小"},{"t":83.08,"text":"这一刻奔赴你"},{"t":86.76,"text":"每个梦里都有段旋律"},{"t":89.68,"text":"每颗心底都有个秘密"},{"t":92.65,"text":"思念如果可以用音符代替"},{"t":96.02,"text":"为你编织这梦的羽翼"},{"t":98.97,"text":"漫天记忆闪耀的烟火"},{"t":101.54,"text":"弥漫世界的每个角落"},{"t":104.56,"text":"音符和诗在星空交织"},{"t":107.68,"text":"一起唱吧"},{"t":108.48,"text":"心中的歌"},{"t":112.25,"text":"啊~啊~啊~啊~"},{"t":118.18,"text":"啊~啊~"},{"t":124.33,"text":"啊~啊~啊~啊~"},{"t":130.28,"text":"啊~啊~"},{"t":136.99,"text":"梦里总有一个人"},{"t":139.13,"text":"温柔的吟唱熟悉的歌声"},{"t":143.01,"text":"多么亲昵的口吻"},{"t":144.91,"text":"告诉我梦想没有不可能"},{"t":148.63,"text":"一切亦幻又亦真"},{"t":151.17,"text":"梦想和现实总密不可分"},{"t":155.01,"text":"皎洁如雪的月轮"},{"t":157.19,"text":"就像你"},{"t":158.05,"text":"微笑时的天真"},{"t":161.11,"text":"世界被音符环绕"},{"t":162.74,"text":"需要你的拥抱"},{"t":164.25,"text":"还有你"},{"t":164.99,"text":"天真的微笑"},{"t":166.66,"text":"要你和我一起寻找"},{"t":168.81,"text":"每一刻的美好"},{"t":173.63,"text":"每个梦里都有段旋律"},{"t":176.6,"text":"每颗心底都有个秘密"},{"t":179.59,"text":"思念如果可以用音符代替"},{"t":182.73,"text":"为你编织这梦的羽翼"},{"t":185.76,"text":"漫天记忆闪耀的烟火"},{"t":188.53,"text":"弥漫世界的每个角落"},{"t":191.49,"text":"音符和诗在星空交织"},{"t":194.32,"text":"一起唱吧"},{"t":195.32,"text":"心中的歌"},{"t":202.26,"text":"每一个梦都是个旋律"},{"t":208,"text":"漫天回忆该如何去聆听"},{"t":213.83,"text":"把心里面的思念传递给你"},{"t":220.3,"text":"让我们一起唱吧"},{"t":224.44,"text":"心中的歌"}]}