{
 "lines": [
  {
   "t": 0,
   "text": "你说时光会像一盏沙漏摔裂在地"
  },
  {
   "t": 4.2,
   "text": "被风吹散之后"
  },
  {
   "t": 8.4,
   "text": "再也不提"
  },
  {
   "t": 12.6,
   "text": "那存放过梦的破碎的玻璃瓶"
  },
  {
   "t": 16.8,
   "text": "成长若是被反复求证的所谓内因"
  },
  {
   "t": 21,
   "text": "病毒般扩散"
  },
  {
   "t": 25.2,
   "text": "却从不可逆"
  },
  {
   "t": 29.4,
   "text": "强迫每个人在乎生存的意义"
  },
  {
   "t": 33.6,
   "text": "上一幕才呱呱坠地"
  },
  {
   "t": 37.8,
   "text": "转眼学会奔跑前进"
  },
  {
   "t": 42,
   "text": "不知疲倦"
  },
  {
   "t": 46.2,
   "text": "倔强的你"
  },
  {
   "t": 50.4,
   "text": "爱是怎样一种情绪"
  },
  {
   "t": 54.6,
   "text": "让人在青春里沉溺"
  },
  {
   "t": 58.8,
   "text": "亢奋焦急"
  },
  {
   "t": 63,
   "text": "侵占逻辑"
  },
  {
   "t": 67.2,
   "text": "你是烙印"
  },
  {
   "t": 71.4,
   "text": "在大地宣告不羁"
  },
  {
   "t": 75.6,
   "text": "向天空呐喊"
  },
  {
   "t": 79.8,
   "text": "展示茁壮的羽翼"
  },
  {
   "t": 84,
   "text": "在每一丛荆棘中寻觅不凋谢的美丽"
  },
  {
   "t": 88.2,
   "text": "你用冷漠"
  },
  {
   "t": 92.4,
   "text": "气市绘分庭抗礼"
  },
  {
   "t": 96.6,
   "text": "嘲讽着所有庸人自扰的议题"
  },
  {
   "t": 100.8,
   "text": "号称热情的代理"
  },
  {
   "t": 105,
   "text": "化身无聊的天敌"
  },
  {
   "t": 109.2,
   "text": "放肆年轻"
  },
  {
   "t": 113.4,
   "text": "你的皱纹如今爬上面具"
  },
  {
   "t": 117.6,
   "text": "遮盖逆鳞"
  },
  {
   "t": 121.8,
   "text": "耳边传来已消散的跫音"
  },
  {
   "t": 126,
   "text": "稀释在水泥森林那片沉默里"
  },
  {
   "t": 130.2,
   "text": "不期然的一文不名"
  },
  {
   "t": 134.4,
   "text": "原来平凡不是演习"
  },
  {
   "t": 138.6,
   "text": "洞若观火"
  },
  {
   "t": 142.8,
   "text": "却看不清自己"
  },
  {
   "t": 147,
   "text": "梦才开始就被惊醒"
  },
  {
   "t": 151.2,
   "text": "旭日划破夜的寂静"
  },
  {
   "t": 155.4,
   "text": "从会刺眼"
  },
  {
   "t": 159.6,
   "text": "到不关心"
  },
  {
   "t": 163.8,
   "text": "如果哪天"
  },
  {
   "t": 168,
   "text": "你再也无力亲吻"
  },
  {
   "t": 172.2,
   "text": "被怨恨撕咬残破的赤子之心"
  },
  {
   "t": 176.4,
   "text": "除了叹息"
  },
  {
   "t": 180.6,
   "text": "你是否还有再呐喊的权力"
  },
  {
   "t": 184.8,
   "text": "等你老去"
  },
  {
   "t": 189,
   "text": "世界不再记得你"
  },
  {
   "t": 193.2,
   "text": "愿你依然存留不被祝福的理性"
  },
  {
   "t": 197.4,
   "text": "来凝视每分每秒"
  },
  {
   "t": 201.6,
   "text": "像迎接末日喧嚣"
  },
  {
   "t": 205.8,
   "text": "宛如回到襁褓"
  },
  {
   "t": 210,
   "text": "你是谁"
  },
  {
   "t": 214.2,
   "text": "斯芬克斯的谜题"
  },
  {
   "t": 218.4,
   "text": "幻想用爱与美镶嵌人间和炼狱"
  },
  {
   "t": 222.6,
   "text": "写得出满纸成熟话语"
  },
  {
   "t": 226.8,
   "text": "却畏惧衰老来袭"
  },
  {
   "t": 231,
   "text": "你会领悟"
  },
  {
   "t": 235.2,
   "text": "西西弗斯的命运"
  },
  {
   "t": 239.4,
   "text": "岁月的真理"
  },
  {
   "t": 243.6,
   "text": "在前路伛偻而行"
  },
  {
   "t": 247.8,
   "text": "枯萎入泥的花朵"
  },
  {
   "t": 252,
   "text": "记得每一场风雨"
  },
  {
   "t": 256.2,
   "text": "曾来过"
  },
  {
   "t": 260.4,
   "text": "又远去"
  }
 ]
}