{"songId":"1979007507","title":"夏虫","lines":[{"t":12.2,"text":"无形的火"},{"t":15.77,"text":"扭曲着世界轮廓"},{"t":18.25,"text":"高温线耗尽"},{"t":21.13,"text":"夏日的盘中"},{"t":22.47,"text":"最后一滴颜色"},{"t":24.27,"text":"面对陌生的茧壳和渺小的自我"},{"t":30.43,"text":"听到广阔晨星银河"},{"t":33.4,"text":"跑进我的耳朵"},{"t":36.32,"text":"若痕迹都不曾亲眼见过"},{"t":38.91,"text":"若连平凡都显得像个传说"},{"t":41.74,"text":"还留什么时间惋惜惶惑"},{"t":44.73,"text":"我们约定在光源处聚合"},{"t":48,"text":"固执的夏虫汲取着美梦解渴"},{"t":53.02,"text":"在湿漉的夜 结群飞行"},{"t":57.35,"text":"就能甩开脆弱"},{"t":59.64,"text":"鞘翅吹折"},{"t":62.03,"text":"竟然描绘出微小漩涡"},{"t":64.8,"text":"问我"},{"t":65.9,"text":"数百天伏蛰 步谁的覆辙"},{"t":69.27,"text":"下一次何时 醒呢"},{"t":76.43,"text":"满载思考的脑袋"},{"t":79.36,"text":"偏爱沉默"},{"t":82.44,"text":"盛不住心事的我"},{"t":85.27,"text":"倾囊而出"},{"t":86.65,"text":"不怕干涸"},{"t":88.05,"text":"命运的天平"},{"t":91.52,"text":"将两手都摊开了"},{"t":93.89,"text":"要在温室和暴风之中取舍"},{"t":97.52,"text":"我忘记了退缩"},{"t":100.5,"text":"若痕迹都不曾亲眼见过"},{"t":103.28,"text":"若连平凡都显得像个传说"},{"t":106.17,"text":"身旁流萤探起万家灯火"},{"t":109.01,"text":"再波澜坎坷也可以依托"},{"t":112.31,"text":"好奇的夏虫向焰火中心奔波"},{"t":117.57,"text":"不论是起点 还是终点"},{"t":121.72,"text":"就算一无所获"},{"t":124.1,"text":"开弓无悔"},{"t":126.14,"text":"为把星点可能性捕捉"},{"t":129.29,"text":"是我"},{"t":130.29,"text":"在风眼出没 将未知触摸"},{"t":134.99,"text":"哪怕只是一瞥见谜底就坠落"},{"t":141.37,"text":"还有无数个想探求的巧合"},{"t":146.99,"text":"哪怕只是领悟到答案的晦涩"},{"t":153.18,"text":"也全力证明所经过都值得"},{"t":164.5,"text":"问我"},{"t":170.07,"text":"是我"},{"t":185.61,"text":"自由的夏虫编织着美梦解渴"},{"t":191.89,"text":"单薄的外壳 展开花纹"},{"t":195.1,"text":"尽将内心诉说"},{"t":197.34,"text":"鞘翅振涌"},{"t":199.22,"text":"卷起击碎定论的漩涡"},{"t":202.16,"text":"等待 数百天伏蛰"},{"t":205.22,"text":"这一瞬冲破"},{"t":206.73,"text":"最高亢的歌 予我"},{"t":213.09,"text":"肆意鸣唱"},{"t":217.55,"text":"直到 嘶哑那刻"}]}