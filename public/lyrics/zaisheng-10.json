{"songId":"2604528481","title":"Aloud","lines":[{"t":2.39,"text":"单手解开喉头盘扣"},{"t":4.3,"text":"只眼就看穿流行的结构"},{"t":6.36,"text":"矗立在这虚拟浪口"},{"t":8.13,"text":"小心 踩不上节奏"},{"t":10.11,"text":"传说被胆识上了锁"},{"t":12.03,"text":"续作无需超级英雄拯救"},{"t":14.04,"text":"但别把回车 错按成空格"},{"t":18.21,"text":"全盛的气场未具雏形"},{"t":19.88,"text":"难道要指望出具证明"},{"t":21.83,"text":"靠唇枪舌刀含沙射影"},{"t":23.61,"text":"无法构成有效挑衅"},{"t":25.81,"text":"我将发辫盘结无限"},{"t":27.73,"text":"只是乐趣不是冠冕"},{"t":29.56,"text":"警示标识很显眼"},{"t":31.37,"text":"别落入怪圈"},{"t":34.03,"text":"疾驰而过紧密赛博鼓点"},{"t":39.04,"text":"敲击时代的牙关"},{"t":41.41,"text":"推促指尖数字流感不停歇"},{"t":48.2,"text":"我无可代替"},{"t":49.67,"text":"哪怕来历已不神秘"},{"t":52.1,"text":"麦克风接力"},{"t":53.72,"text":"百万人就等我出席"},{"t":56,"text":"唱衰或好戏"},{"t":57.44,"text":"都为昙花注入常青的选题"},{"t":60.83,"text":"我的登场即是天意"},{"t":72.8,"text":"风评不辛辣 不够格扮演独行侠"},{"t":76.6,"text":"胡乱抛章法 ほらみてこのせかい"},{"t":80.28,"text":"话题红利熬红眼睛"},{"t":82.14,"text":"就连碰壁也要庆幸"},{"t":84.26,"text":"再生数不是等你"},{"t":86.09,"text":"换乘的客机"},{"t":88.83,"text":"疾驰而过紧密赛博鼓点"},{"t":93.64,"text":"敲击时代的牙关"},{"t":96.18,"text":"推促指尖数字流感不停歇"},{"t":102.81,"text":"我奉陪到底"},{"t":104.33,"text":"细数我够不够资历"},{"t":106.69,"text":"放大至毫厘"},{"t":108.21,"text":"有几种推敲经得起"},{"t":110.71,"text":"重复我姓名"},{"t":112.08,"text":"摒弃杂音落定浮躁的眼睛"},{"t":115.32,"text":"记住我是确有此意"},{"t":135.06,"text":"Follow my guide way from the lost dream to the sky"},{"t":142.69,"text":"车辙会将非议一并覆盖"},{"t":149.69,"text":"我无可代替"},{"t":151.14,"text":"哪怕来历已不神秘"},{"t":153.53,"text":"麦克风接力"},{"t":155.02,"text":"百万人就等我出席"},{"t":157.54,"text":"唱衰或好戏"},{"t":158.97,"text":"都为昙花注入常青的选题"},{"t":162.34,"text":"我的登场即是天意"},{"t":165.78,"text":"我奉陪到底"},{"t":166.77,"text":"细数我够不够资历"},{"t":169.17,"text":"放大至毫厘"},{"t":170.77,"text":"有几种推敲经得起"},{"t":173.07,"text":"重复我姓名"},{"t":174.81,"text":"摒弃杂音落定浮躁的眼睛"},{"t":178.12,"text":"记住我是确有此意"}]}