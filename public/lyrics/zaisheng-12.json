{"songId":"2604527605","title":"最完美的夏天","lines":[{"t":13.44,"text":"想重启时间"},{"t":16.52,"text":"回我们最初的地点"},{"t":23.45,"text":"oh～"},{"t":26.26,"text":"看阳光扑面"},{"t":29.21,"text":"环抱你青涩的容颜"},{"t":36.27,"text":"oh～"},{"t":39.02,"text":"天空的颜色"},{"t":42.36,"text":"变幻得像青春的脸"},{"t":48.84,"text":"oh～"},{"t":51.83,"text":"成长的幻觉"},{"t":54.88,"text":"是自以为习惯离别"},{"t":64.26,"text":"ah～"},{"t":65.15,"text":"从未有过这样的夏天"},{"t":68.41,"text":"仿佛一切在此刻终结"},{"t":71.7,"text":"能不能不要说再见"},{"t":76.06,"text":"好想问你"},{"t":78.81,"text":"曾期许的是否已实现"},{"t":83.36,"text":"还是也被世界改变"},{"t":89.18,"text":"oh"},{"t":90.55,"text":"这是我最完美的夏天"},{"t":94.3,"text":"拥抱过就忍住泪往前"},{"t":97.33,"text":"但愿我无论走多远"},{"t":101.57,"text":"也会记得"},{"t":104.6,"text":"那些给我温柔的双眼"},{"t":108.91,"text":"yeah"},{"t":111.8,"text":"它们藏着"},{"t":114.56,"text":"所有夏天"},{"t":128.85,"text":"曾彻夜聊天"},{"t":131.82,"text":"幻想未来的画面"},{"t":138.61,"text":"oh～"},{"t":141.39,"text":"后来才懂得"},{"t":144.53,"text":"平常的事最值得纪念"},{"t":151.27,"text":"oh～"},{"t":154.83,"text":"从未有过这样的夏天"},{"t":157.9,"text":"仿佛一切在此刻终结"},{"t":161.12,"text":"能不能不要说再见"},{"t":165.67,"text":"好想问你"},{"t":168.25,"text":"曾期许的是否已实现"},{"t":172.89,"text":"还是也被世界改变"},{"t":178.43,"text":"oh"},{"t":180.3,"text":"这是我最完美的夏天"},{"t":183.52,"text":"拥抱过就忍住泪往前"},{"t":186.77,"text":"但愿我无论走多远"},{"t":191.09,"text":"也会记得"},{"t":193.92,"text":"就在某一个平凡瞬间"},{"t":198.44,"text":"yeah"},{"t":201.24,"text":"你给过我"},{"t":203.97,"text":"所有夏天"}]}