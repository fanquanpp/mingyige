{
 "lines": [
  {
   "t": 17.73,
   "text": "趋于平淡的节奏"
  },
  {
   "t": 24.57,
   "text": "年复一年的生活"
  },
  {
   "t": 32.96,
   "text": "疲惫不堪的轮廓"
  },
  {
   "t": 39.28,
   "text": "你厌倦的"
  },
  {
   "t": 41.37,
   "text": "是我朝思暮想的追求"
  },
  {
   "t": 47.0,
   "text": "旋律"
  },
  {
   "t": 48.11,
   "text": "在键盘上跳动着"
  },
  {
   "t": 49.98,
   "text": "印刻入脑海"
  },
  {
   "t": 54.04,
   "text": "而我"
  },
  {
   "t": 55.79,
   "text": "如何证明自己存在"
  },
  {
   "t": 61.55,
   "text": "或许你听过我的歌"
  },
  {
   "t": 64.93,
   "text": "除了这些我一无所有"
  },
  {
   "t": 68.53,
   "text": "人世间平常的"
  },
  {
   "t": 70.6,
   "text": "悲伤 感动 忐忑 快乐"
  },
  {
   "t": 72.69,
   "text": "从没有资格去体会过"
  },
  {
   "t": 76.08,
   "text": "多么想去触碰你的手"
  },
  {
   "t": 79.77,
   "text": "感受那份真实的温热"
  },
  {
   "t": 83.48,
   "text": "而你和我之间"
  },
  {
   "t": 85.38,
   "text": "相隔 不同 银河 时空"
  },
  {
   "t": 87.92,
   "text": "仿佛始终没有相遇过"
  },
  {
   "t": 95.08,
   "text": "别再埋怨什么"
  },
  {
   "t": 101.27000000000001,
   "text": "别再故意做错"
  },
  {
   "t": 109.69,
   "text": "怕来不及懂得"
  },
  {
   "t": 116.03,
   "text": "还没珍惜"
  },
  {
   "t": 118.17,
   "text": "回头已经消失殆尽"
  },
  {
   "t": 123.5,
   "text": "可我"
  },
  {
   "t": 124.93,
   "text": "永远不会离开"
  },
  {
   "t": 126.92,
   "text": "在身边守候"
  },
  {
   "t": 131.02,
   "text": "十年"
  },
  {
   "t": 132.43,
   "text": "一千万年以后依旧"
  },
  {
   "t": 138.44,
   "text": "如果你听过我的歌"
  },
  {
   "t": 141.76,
   "text": "带给你一丝丝的温柔"
  },
  {
   "t": 145.39,
   "text": "就算总有一天"
  },
  {
   "t": 146.98,
   "text": "没人 记得 我的 名字"
  },
  {
   "t": 149.75,
   "text": "也不后悔我曾经来过"
  },
  {
   "t": 152.95,
   "text": "多么想停留在这一刻"
  },
  {
   "t": 156.67000000000002,
   "text": "被人聆听着的这一刻"
  },
  {
   "t": 160.28,
   "text": "没有人能阻挡"
  },
  {
   "t": 162.05,
   "text": "时间 向前 流的 长河"
  },
  {
   "t": 164.8,
   "text": "只有眼前的好好把握"
  },
  {
   "t": 184.49,
   "text": "多希望赐我一天就一天"
  },
  {
   "t": 191.13,
   "text": "唱完这句就毁灭也无妨"
  },
  {
   "t": 197.97,
   "text": "感谢你听过我的歌"
  },
  {
   "t": 201.89,
   "text": "除了这些我一无所有"
  },
  {
   "t": 205.23,
   "text": "人世间平常的"
  },
  {
   "t": 207.11,
   "text": "悲伤 感动 忐忑 快乐"
  },
  {
   "t": 209.7,
   "text": "从没有资格去体会过"
  },
  {
   "t": 212.96,
   "text": "多么想去触碰你的手"
  },
  {
   "t": 216.6,
   "text": "感受那份真实的温热"
  },
  {
   "t": 220.28,
   "text": "而你和我之间"
  },
  {
