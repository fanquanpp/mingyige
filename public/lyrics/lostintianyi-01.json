  {
   "t": 98.24000000000001,
   "text": "大闹一场的狼藉"
  },
  {
   "t": 100.5,
   "text": "骇俗到不可思议"
  },
  {
   "t": 102.94,
   "text": "来自8102的恶意就在这里"
  },
  {
   "t": 117.64,
   "text": "反复争议却又完全没改观的话题"
  },
  {
   "t": 121.9,
   "text": "很快就被忘记（被忘记 被忘记）"
  },
  {
   "t": 126.86,
   "text": "前赴后继却在指摘之下没了声息"
  },
  {
   "t": 131.35,
   "text": "凝固曾回温的一点一滴"
  },
  {
   "t": 136.26,
   "text": "林立楼宇穿梭来去的身影"
  },
  {
   "t": 140.99,
   "text": "烙印在清澈眼底深深扎根我生命"
  },
  {
   "t": 145.8,
   "text": "乏味地发生又重演"
  },
  {
   "t": 149.01,
   "text": "涂抹再改写"
  },
  {
   "t": 151.34,
   "text": "孤身一人沉默的辩解"
  },
  {
   "t": 155.9,
   "text": "即使认真对待每时每刻"
  },
  {
   "t": 160.64,
   "text": "碾着愿望的车轮仍在转动"
  },
  {
   "t": 165.6,
   "text": "逆转既定的福祸"
  },
  {
   "t": 167.53,
   "text": "重置戏剧性因果"
  },
  {
   "t": 170.2,
   "text": "苦思冥想后剧本只字未落"
  },
  {
   "t": 174.85,
   "text": "即使将成见抛下按本心所想而活"
  },
  {
   "t": 179.55,
   "text": "透过旧规矩旧思绪的囹圄能看到什么"
