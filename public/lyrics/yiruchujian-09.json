{"songId":"1979009861","title":"光与影的对白","lines":[{"t":24.88,"text":"当重逢你清澈眼睛"},{"t":28.34,"text":"围困我在孤岛的潮汐退去"},{"t":31.79,"text":"蔚蓝涌向干涸心扉印记"},{"t":35.88,"text":"不要急于将我唤醒"},{"t":39.32,"text":"即使幸福仅是片刻相聚"},{"t":42.82,"text":"敲下音符不为叹息"},{"t":46.18,"text":"循糯米香漫步街井 大快朵颐"},{"t":49.55,"text":"佳酿一盏听女儿意气"},{"t":52.23,"text":"雨露沾衣 信手拈起"},{"t":54.82,"text":"一花竟藏一世界欢喜"},{"t":57.79,"text":"寒星坠地 白鸟飞去"},{"t":60.22,"text":"千宵灯火转眼便览尽"},{"t":65.55,"text":"都历历铭记"},{"t":67.9,"text":"将故事传颂吧"},{"t":69.77,"text":"风携它远追"},{"t":73.2,"text":"向宿命改写时"},{"t":75.55,"text":"字句皆成碑"},{"t":78.7,"text":"你脸颊热泪"},{"t":80.97,"text":"绝非被谁取笑的愚昧"},{"t":84.86,"text":"愿歌声给些许快慰"},{"t":109.5,"text":"微弱旋律穿越星河 似远航孤星"},{"t":112.71,"text":"雨滴琴键上跃动不息"},{"t":115.75,"text":"除岁雪临 檐下相倚"},{"t":118.35,"text":"听我诉说闪耀的光阴"},{"t":121.32,"text":"小指勾起 一言为定"},{"t":123.92,"text":"夏虫振翅向灼热光明"},{"t":129.16,"text":"为挚爱而叙"},{"t":131.39,"text":"听共鸣回响吧"},{"t":133.65,"text":"呐喊正纷飞"},{"t":136.59,"text":"跌落重来便是"},{"t":138.88,"text":"启程就无悔"},{"t":142.03,"text":"你一路喜悲"},{"t":144.28,"text":"又怎会无人了解体会"},{"t":148.51,"text":"旅途未完 千山万水空白待绘"},{"t":158.86,"text":"枯荣相随"},{"t":165.03,"text":"泥泞步履踏碎泪泊"},{"t":168.19,"text":"拥向光如抱薪赴火"},{"t":170.81,"text":"妄想着永不分离的梦"},{"t":177.85,"text":"幸福从非泡影"},{"t":180.49,"text":"以笑容证明"},{"t":183.53,"text":"交汇的光与影"},{"t":185.8,"text":"答案落定覆上姓名"},{"t":189.42,"text":"为了你唱下去"},{"t":191.67,"text":"为你将希冀传递"},{"t":195.35,"text":"歌声将你我紧系"},{"t":200.48,"text":"最黯淡的一个"},{"t":202.29,"text":"梦最为炽热"},{"t":205.56,"text":"万千孤单焰火"},{"t":207.79,"text":"让这虚构灵魂鲜活"},{"t":211.41,"text":"至少在这一刻"},{"t":214.35,"text":"热爱不问为何"},{"t":217.3,"text":"存在为将心声响彻"},{"t":223.18,"text":"多少岁月想要伴你走过"},{"t":228.6,"text":"燕回春野 蝉鸣夏夜"},{"t":231.09,"text":"说予我"}]}