{"songId":"3402764237","title":"心音","lines":[{"t":1.88,"text":"斑驳信号调频 滴滴答 听不清"},{"t":4.86,"text":"是什么将我唤醒"},{"t":6.79,"text":"走走停停"},{"t":7.75,"text":"学着融入行色匆匆人群"},{"t":11.63,"text":"橱窗透明玻璃 倒映出我身形"},{"t":14.53,"text":"满怀认真神情"},{"t":16.34,"text":"探寻 约定后被遗忘奏鸣"},{"t":42.24,"text":"你孤独眼睛"},{"t":44.11,"text":"辉映了窗外星星"},{"t":46.44,"text":"烦心事说不清"},{"t":48.71,"text":"日记本锁眼结冰"},{"t":51.64,"text":"你无声口型"},{"t":53.69,"text":"默念的诗句点石成金"},{"t":56.09,"text":"忍耐着无人问津"},{"t":57.66,"text":"维护紧锁内心"},{"t":60.19,"text":"是漫长光阴"},{"t":62.38,"text":"无情掩埋了共鸣心音？"},{"t":65.91,"text":"还是源自过时嗓音？"},{"t":70.42,"text":"玻璃氤氲雾气 泪盈盈 看不清"},{"t":73.21,"text":"货架正时刻上新"},{"t":75.25,"text":"冷冷清清"},{"t":76.84,"text":"于某个时刻你好奇问询"},{"t":80.2,"text":"忽略悲伤表情 我们交换姓名"},{"t":83.14,"text":"摒弃外界杂音"},{"t":85.05,"text":"倾听 未曾出口刻骨铭心"},{"t":110.32,"text":"你所有心情"},{"t":112.47,"text":"渴望被温柔聆听"},{"t":115.02,"text":"从夜晚说到黎明"},{"t":116.95,"text":"烦恼拌着糖搅匀"},{"t":120.05,"text":"呼唤我姓名"},{"t":122.17,"text":"过往的故事雨过天晴"},{"t":124.77,"text":"舞台上划过流星"},{"t":126.11,"text":"闪耀无须证明"},{"t":128.93,"text":"穿透过光阴"},{"t":130.11,"text":"竭力为你我相遇共鸣"},{"t":134.43,"text":"曾经嗓音唤醒如今"},{"t":139.23,"text":"隔着橱窗玻璃 被挑选 被看轻"},{"t":141.84,"text":"挫折打不碎真心"},{"t":143.86,"text":"走过艰辛"},{"t":144.92,"text":"是勇敢点亮了微弱流星"},{"t":149.17,"text":"波段调试对应 你我视线同频"},{"t":151.73,"text":"哪怕心声无形"},{"t":153.86,"text":"也请 认真刻下你我名姓"},{"t":168.58,"text":"斑驳信号调频 滴滴答 听不清"},{"t":171.33,"text":"为什么无人接听？"},{"t":173.34,"text":"时间乱流轰鸣 从遥远 到清晰"},{"t":176.04,"text":"传来坚定的声音"},{"t":178.34,"text":"点点滴滴"},{"t":179.15,"text":"全都是我们最真切心情"},{"t":182.85,"text":"澄澈歌声牵引 我的心 也共鸣"},{"t":185.85,"text":"就算重复千遍 相遇"},{"t":189.04,"text":"仍然愿意与你 再次奏鸣"},{"t":193.33,"text":"我们刻下约定"}]}