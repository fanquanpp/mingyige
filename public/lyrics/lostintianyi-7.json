{
 "lines": [
  {
   "t": 0,
   "text": "州城外天河挟危山如故"
  },
  {
   "t": 4.2,
   "text": "最是形胜处 商贾往来贮足"
  },
  {
   "t": 8.4,
   "text": "此去即蛮郊绝域"
  },
  {
   "t": 12.6,
   "text": "不知葬何朝荒骨"
  },
  {
   "t": 16.8,
   "text": "春风苍凉 草木荣枯终是尘土"
  },
  {
   "t": 21,
   "text": "去路茫茫"
  },
  {
   "t": 25.2,
   "text": "三千世界 几多爱恨情长"
  },
  {
   "t": 29.4,
   "text": "孤烟郎月 几对儿女相偿"
  },
  {
   "t": 33.6,
   "text": "众生业障 换谁难舍难忘"
  },
  {
   "t": 37.8,
   "text": "挣脱不得 可是这副旧皮囊"
  },
  {
   "t": 42,
   "text": "参られ！"
  },
  {
   "t": 46.2,
   "text": "沧海求粟亦是狂"
  },
  {
   "t": 50.4,
   "text": "佛灯欲照尽世间荒唐皆殊途"
  },
  {
   "t": 54.6,
   "text": "我身弊袍幂篱斩"
  },
  {
   "t": 58.8,
   "text": "妄徒孽畜"
  },
  {
   "t": 63,
   "text": "舀瓢弱水止渴"
  },
  {
   "t": 67.2,
   "text": "窥得谁面目清楚"
  },
  {
   "t": 71.4,
   "text": "忽忽天涯客"
  },
  {
   "t": 75.6,
   "text": "哪个糊涂哪个无辜"
  },
  {
   "t": 79.8,
   "text": "八荒六合太孤独"
  },
  {
   "t": 84,
   "text": "狭路相逢应有所悟"
  },
  {
   "t": 88.2,
   "text": "不问汝名姓 只问先生态度"
  },
  {
   "t": 92.4,
   "text": "尘寰多苦厄 借刀剑来渡"
  },
  {
   "t": 96.6,
   "text": "杏花雨乱 湿了红妆"
  },
  {
   "t": 100.8,
   "text": "参られ！"
  },
  {
   "t": 105,
   "text": "往生何往"
  },
  {
   "t": 109.2,
   "text": "心欲不染它物"
  },
  {
   "t": 113.4,
   "text": "飞沙从来乱目"
  },
  {
   "t": 117.6,
   "text": "青纱浊酒俱在"
  },
  {
   "t": 121.8,
   "text": "来者自由归处"
  },
  {
   "t": 126,
   "text": "须知这距汉地"
  },
  {
   "t": 130.2,
   "text": "不下百八十里数"
  },
  {
   "t": 134.4,
   "text": "性命由不得片刻耽误"
  },
  {
   "t": 138.6,
   "text": "生死俱欢何须恕"
  }
 ]
}