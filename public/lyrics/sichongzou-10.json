{"songId":"3402764812","title":"地府美食家","lines":[{"t":6.48,"text":"灯昏暗 踏幽冥途心慌慌"},{"t":10.34,"text":"天气寒 铁链与肚子同时响"},{"t":14.63,"text":"黑影晃 凑近看是间鬼餐馆"},{"t":18.84,"text":"老板娘 麻烦请给我菜单"},{"t":23.15,"text":"我要一份业火烤蹄"},{"t":24.86,"text":"一份忘川布丁 和白无常大米"},{"t":27.25,"text":"再来一份百骨红烧"},{"t":29.02,"text":"一个双煞汉堡 十八层蛋糕"},{"t":31.36,"text":"再来一碗孟婆酸汤"},{"t":33.39,"text":"三根黑魂烤肠 和夜影鲜肚煲"},{"t":35.79,"text":"别忘记用彼岸花摆盘"},{"t":40.07,"text":"我真的好饿"},{"t":48.59,"text":"急急如律令"},{"t":50.49,"text":"肥肥我高兴"},{"t":52.62,"text":"饿饿要人命"},{"t":54.41,"text":"地府美食吃不腻"},{"t":56.67,"text":"急急如律令"},{"t":58.56,"text":"肚肚响地狱"},{"t":61.08,"text":"心默念天灵灵地灵灵"},{"t":63.01,"text":"统统都吃干净"},{"t":82.03,"text":"筷如枪 扫光一盘又一盘"},{"t":86.11,"text":"五更半 本店要天亮才打烊"},{"t":90.42,"text":"美食家 嘴巴从不会说谎"},{"t":94.58,"text":"老板娘 我想我还要加单"},{"t":98.95,"text":"我要一杯灵珠奶茶"},{"t":100.7,"text":"一份曼珠沙拉 一份阎王披萨"},{"t":102.91,"text":"再来一份轮回断肠"},{"t":104.81,"text":"一份亡命浓汤 一颗忘忧糖"},{"t":107.21,"text":"再来一份牛头马面"},{"t":109.04,"text":"一份地府三鲜 地狱油锅春卷"},{"t":111.37,"text":"要健康记得少一点加盐"},{"t":115.78,"text":"我真的好饿"},{"t":124.14,"text":"急急如律令"},{"t":126.15,"text":"肥肥我高兴"},{"t":128.23,"text":"饿饿要人命"},{"t":130.36,"text":"地府美食吃不腻"},{"t":132.56,"text":"急急如律令"},{"t":134.57,"text":"肚肚响地狱"},{"t":136.58,"text":"心默念天灵灵地灵灵"},{"t":138.87,"text":"统统都吃干净"},{"t":141.01,"text":"般若波罗蜜"},{"t":142.84,"text":"饮食皆修行"},{"t":145.11,"text":"有果必有因"},{"t":147,"text":"浪费食物下地狱"},{"t":149.48,"text":"婆珊婆演底"},{"t":152.07,"text":"修炼胃与心"},{"t":153.68,"text":"我已经吃完天再吃完地"},{"t":155.56,"text":"越扶墙越开心"},{"t":174.66,"text":"老板娘追着我要好评"},{"t":176.68,"text":"必须五星 差评没命"},{"t":178.88,"text":"结账不扫码只收冥币"},{"t":181.03,"text":"欢迎下次光临"},{"t":183.18,"text":"在黄泉路上的鬼餐厅"},{"t":185.02,"text":"你信不信 不信也行"},{"t":187.1,"text":"头顶的太阳慢慢升起"},{"t":189.17,"text":"床头闹钟叮叮"},{"t":191.39,"text":"闹钟叮叮 原来是梦那这顿算预支奖金"},{"t":195.57,"text":"满汉全席 有了力气敢跟世界比腕力"},{"t":199.85,"text":"撑起肚皮 才能够守住当下每份惬意"},{"t":204.05,"text":"满满魄力 天上地下任我行"}]}