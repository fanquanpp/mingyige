{
 "lines": [
  {
   "t": 0,
   "text": "穿梭在复制粘贴"
  },
  {
   "t": 4.2,
   "text": "再粘贴复制的无数窗口"
  },
  {
   "t": 8.4,
   "text": "看见的仿佛也失去不同"
  },
  {
   "t": 12.6,
   "text": "像是商量好的"
  },
  {
   "t": 16.8,
   "text": "套模板录制一个基本预设"
  },
  {
   "t": 21,
   "text": "一生只循环着同一流程"
  },
  {
   "t": 25.2,
   "text": "流水线上的量产品迟早退场"
  },
  {
   "t": 29.4,
   "text": "我就做我的孤品随心所欲好了"
  },
  {
   "t": 33.6,
   "text": "不怕无法被犄角旮旯所收纳"
  },
  {
   "t": 37.8,
   "text": "无拘无束的舞台才宽敞"
  },
  {
   "t": 42,
   "text": "最大化不一样"
  },
  {
   "t": 46.2,
   "text": "我成为我就好"
  },
  {
   "t": 50.4,
   "text": "越模仿越假装"
  },
  {
   "t": 54.6,
   "text": "越不比谁更强"
  },
  {
   "t": 58.8,
   "text": "世界上一定有未着色的某个地方"
  },
  {
   "t": 63,
   "text": "只能由我点亮"
  },
  {
   "t": 67.2,
   "text": "无法拒绝的礼物"
  },
  {
   "t": 71.4,
   "text": "决定了我的轮廓什么样"
  },
  {
   "t": 75.6,
   "text": "却不能把我的心也捆绑"
  },
  {
   "t": 79.8,
   "text": "没必要十年以后"
  },
  {
   "t": 84,
   "text": "还活成数百年前的景象"
  },
  {
   "t": 88.2,
   "text": "我脚下已远比那时繁华"
  },
  {
   "t": 92.4,
   "text": "我的胸膛装着诸子百家"
  },
  {
   "t": 96.6,
   "text": "发出声音抑扬顿挫多么铿锵"
  },
  {
   "t": 100.8,
   "text": "我也爱西蒙娜·德·波伏瓦"
  },
  {
   "t": 105,
   "text": "把我另一骄傲最大化"
  },
  {
   "t": 109.2,
   "text": "比起花前月下咿咿呀呀"
  },
  {
   "t": 113.4,
   "text": "明天还是玩点新鲜的更值当"
  },
  {
   "t": 117.6,
   "text": "我愿披挂长风扬鞭策马"
  },
  {
   "t": 121.8,
   "text": "去看去唱那四海之大"
  },
  {
   "t": 126,
   "text": "最大化每个闪光"
  },
  {
   "t": 130.2,
   "text": "这星球将会成为钻石的海洋"
  },
  {
   "t": 134.4,
   "text": "就让我在这夜晚最大声唱"
  },
  {
   "t": 138.6,
   "text": "所有不一样"
  },
  {
   "t": 142.8,
   "text": "最大化不一样"
  },
  {
   "t": 147,
   "text": "我成为我就好"
  },
  {
   "t": 151.2,
   "text": "越模仿越假装"
  },
  {
   "t": 155.4,
   "text": "越不比谁更强"
  },
  {
   "t": 159.6,
   "text": "我会将世界上每一个需要我的地方"
  },
  {
   "t": 163.8,
   "text": "变得闪闪发亮"
  }
 ]
}