{
 "lines": [
  {
   "t": 22.17,
   "text": "穿梭在复制粘贴"
  },
  {
   "t": 24.07,
   "text": "再粘贴复制的无数窗口"
  },
  {
   "t": 27.26,
   "text": "看见的仿佛也失去不同"
  },
  {
   "t": 32.15,
   "text": "像是商量好的"
  },
  {
   "t": 33.69,
   "text": "套模板录制一个基本预设"
  },
  {
   "t": 37.11,
   "text": "一生只循环着同一流程"
  },
  {
   "t": 41.76,
   "text": "流水线上的量产品迟早退场"
  },
  {
   "t": 46.57,
   "text": "我就做我的孤品随心所欲好了"
  },
  {
   "t": 51.32,
   "text": "不怕无法被犄角旮旯所收纳"
  },
  {
   "t": 56.52,
   "text": "无拘无束的舞台才宽敞"
  },
  {
   "t": 60.99,
   "text": "最大化不一样"
  },
  {
   "t": 63.38,
   "text": "我成为我就好"
  },
  {
   "t": 66.13,
   "text": "越模仿越假装"
  },
  {
   "t": 68.59,
   "text": "越不比谁更强"
  },
  {
   "t": 70.89,
   "text": "世界上一定有未着色的某个地方"
  },
  {
   "t": 75.93,
   "text": "只能由我点亮"
  },
  {
   "t": 80.21000000000001,
   "text": "无法拒绝的礼物"
  },
  {
   "t": 85.28,
   "text": "决定了我的轮廓什么样"
  },
  {
   "t": 88.13,
   "text": "却不能把我的心也捆绑"
  },
  {
   "t": 92.41,
   "text": "没必要十年以后"
  },
  {
   "t": 95.13,
   "text": "还活成数百年前的景象"
  },
  {
   "t": 97.87,
   "text": "我脚下已远比那时繁华"
  },
  {
   "t": 102.89,
   "text": "我的胸膛装着诸子百家"
  },
  {
   "t": 104.82,
   "text": "发出声音抑扬顿挫多么铿锵"
  },
  {
   "t": 107.56,
   "text": "我也爱西蒙娜·德·波伏瓦"
  },
  {
   "t": 109.81,
   "text": "把我另一骄傲最大化"
  },
  {
   "t": 112.55,
   "text": "比起花前月下咿咿呀呀"
  },
  {
   "t": 114.59,
   "text": "明天还是玩点新鲜的更值当"
  },
  {
   "t": 117.36,
   "text": "我愿披挂长风扬鞭策马"
  },
  {
   "t": 119.4,
   "text": "去看去唱那四海之大"
  },
  {
   "t": 141.81,
   "text": "最大化每个闪光"
  },
  {
   "t": 145.7,
   "text": "这星球将会成为钻石的海洋"
  },
  {
   "t": 151.76,
   "text": "就让我在这夜晚最大声唱"
  },
  {
   "t": 158.45,
   "text": "所有不一样"
  },
  {
   "t": 161.64,
   "text": "最大化不一样"
  },
  {
   "t": 163.99,
   "text": "我成为我就好"
  },
  {
   "t": 166.6,
   "text": "越模仿越假装"
  },
  {
   "t": 168.9,
   "text": "越不比谁更强"
  },
  {
   "t": 171.3,
   "text": "我会将世界上每一个需要我的地方"
  },
  {
   "t": 176.21,
   "text": "变得闪闪发亮"
  }
 ]
}
