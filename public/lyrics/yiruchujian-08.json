{"songId":"1979009860","title":"一花依世界","lines":[{"t":11.51,"text":"飞红遮艳阳"},{"t":13.16,"text":"着一身新裳藏半个香囊"},{"t":16.65,"text":"轻舟谁在掌"},{"t":18.48,"text":"缓些晃涟漪片片怎让梳妆"},{"t":21.8,"text":"花桥随波漾"},{"t":23.64,"text":"那芬芳 慢慢酝酿"},{"t":26.93,"text":"载几缕思量身旁"},{"t":29.54,"text":"花开满堂"},{"t":30.57,"text":"盛放水中央"},{"t":32.28,"text":"微风吻荷塘"},{"t":33.96,"text":"竹篙一点点把时间拉长"},{"t":37.24,"text":"待笑靥绽放"},{"t":39.27,"text":"就好像胭脂红了脸颊的妆"},{"t":42.65,"text":"捧水一把 映着那白云流霞"},{"t":46.54,"text":"发着呆欣赏"},{"t":47.73,"text":"扎起着的髻发"},{"t":49.8,"text":"忘了阿妈的话"},{"t":51.64,"text":"解开了魔法"},{"t":55.4,"text":"像是踏入了未来的童话"},{"t":60.14,"text":"回转着的陌生影像"},{"t":65.71,"text":"好奇的想法从未停下"},{"t":69.13,"text":"谁来回答"},{"t":71.95,"text":"唉 哎呀哎呀"},{"t":105.21,"text":"人来又人往"},{"t":107.17,"text":"透过落地窗瞧一眼繁忙"},{"t":110.46,"text":"东张又西望"},{"t":112.3,"text":"路中央高厦楼房好似盛唐"},{"t":115.57,"text":"午后点心坊"},{"t":117.79,"text":"蟹壳黄阵阵酥香"},{"t":120.83,"text":"绕过陆家浜 松江"},{"t":123.39,"text":"穿过城隍"},{"t":124.59,"text":"飘进了心房"},{"t":128.07,"text":"像是踏入了未来的童话"},{"t":133.21,"text":"左顾右盼 眼底风光"},{"t":138.59,"text":"好奇的想法从未停下"},{"t":142.39,"text":"谁来回答"},{"t":145.29,"text":"嘿 罢啦罢啦"},{"t":147.31,"text":"抬头仰望夜空多安详"},{"t":152.4,"text":"未来过往同是一轮月光"},{"t":157.83,"text":"华灯初上"},{"t":159.7,"text":"多想时间停下"},{"t":163.08,"text":"给我一生最珍贵的魔法"},{"t":189.01,"text":"或许不安 也有过失望"},{"t":194.09,"text":"面对未知 总会有彷徨"},{"t":199.3,"text":"如果害怕停下了"},{"t":203.98,"text":"就不叫做成长"},{"t":210.25,"text":"如果希望是漫天星光"},{"t":214.95,"text":"捉个迷藏"},{"t":216.83,"text":"世界到处流浪"},{"t":220.28,"text":"烟花绽放 多想时间停下"},{"t":225.45,"text":"定格这一生最珍贵的刹那"},{"t":231.18,"text":"如果希望是漫天星光"},{"t":235.97,"text":"许个愿望 世界充满想象"},{"t":241.29,"text":"有太多话藏在心里萌芽"},{"t":246.36,"text":"未来想和你们一起长大"}]}