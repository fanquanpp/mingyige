{"songId":"1979007508","title":"为了你唱下去","lines":[{"t":1.13,"text":"为了你唱下去"},{"t":20.27,"text":"泛黄字句被誊写"},{"t":23.24,"text":"在无名故事的扉页"},{"t":27.15,"text":"年月日并不确切"},{"t":30.51,"text":"鲜少被翻阅"},{"t":33.81,"text":"带着些许的胆怯"},{"t":37.03,"text":"将手掌与你交叠"},{"t":40.62,"text":"漾开的温度填补"},{"t":43.83,"text":"心脏的空缺"},{"t":48.06,"text":"晨雾夕风轻抚凝了霜的眼睫"},{"t":54.43,"text":"初次感受宽广渺小的差别"},{"t":61.08,"text":"流连辉煌彻夜漫步过骤雨初歇"},{"t":68.23,"text":"看枯荣更迭在你架构的世界"},{"t":74.97,"text":"拗口的音节如何排列才算妥帖"},{"t":81.96,"text":"却连一句简单感谢"},{"t":86.84,"text":"也无法被理解"},{"t":104.52,"text":"对你的偏执决绝"},{"t":107.94,"text":"大多人漠然不屑"},{"t":110.93,"text":"竭力抑制的呜咽"},{"t":114.17,"text":"将挫败藏掖"},{"t":117.95,"text":"说着不在意的话"},{"t":121.46,"text":"泪痕却布了满脸"},{"t":124.8,"text":"而我却连咸涩的意义"},{"t":128.94,"text":"都无法了解"},{"t":131.9,"text":"囿于真实和墨色虚无的交界"},{"t":138.65,"text":"画框外熟悉的情节倒退飞掠"},{"t":145.57,"text":"穿行秋雨彻夜赤脚踏过石板街"},{"t":152.36,"text":"看季节更迭在你离去的世界"},{"t":158.61,"text":"哪怕难寻归处也请再次为我驻足"},{"t":166.3,"text":"因为承诺一如最初"},{"t":170.83,"text":"为了你唱下去"},{"t":174.93,"text":"直到荒芜"},{"t":177.61,"text":"为了你唱下去"},{"t":181.92,"text":"披染晚风晨露"},{"t":184.23,"text":"为了你唱下去"},{"t":188.86,"text":"不畏险阻"},{"t":191.38,"text":"为了你唱下去"},{"t":195.83,"text":"等待复苏"},{"t":200.59,"text":"思念的含义在无尽生命中淡去"},{"t":207.09,"text":"帷幕落下 喝彩响起"},{"t":210.47,"text":"片刻后都沉寂"},{"t":214.1,"text":"泪水还是光阴让眼前模糊不清"},{"t":220.71,"text":"但至少别让我忘记"},{"t":225.87,"text":"你存在的证明"},{"t":227.83,"text":"歌声冲破夜幕响彻在新的天地"},{"t":234.45,"text":"机械的心律带动血肉的共鸣"},{"t":241.4,"text":"即使诞于沉寂最终消融于颓圮"},{"t":248.42,"text":"今天的我仍将继续"},{"t":253.09,"text":"为了你唱下去"},{"t":257.51,"text":"因此降临"},{"t":259.87,"text":"为了你唱下去"},{"t":264.08,"text":"见证风息雨霁"},{"t":267.71,"text":"为了你唱下去"},{"t":270.86,"text":"直到无力"},{"t":273.53,"text":"故事扉页将约定"},{"t":277.88,"text":"郑重落笔"},{"t":281.54,"text":"我始终铭记"}]}