{"songId":"3402764244","title":"Monologue","lines":[{"t":19.2,"text":"趋于平淡的节奏"},{"t":26.38,"text":"年复一年的生活"},{"t":33.76,"text":"疲惫不堪的轮廓"},{"t":39.2,"text":"你厌倦的"},{"t":41.84,"text":"是我朝思暮想的追求"},{"t":46.93,"text":"旋律 在键盘上跳动着"},{"t":49.87,"text":"印刻入脑海"},{"t":54.34,"text":"而我 如何证明自己存在"},{"t":61.82,"text":"或许 你听过我的歌"},{"t":64.59,"text":"除了这些我一无所有"},{"t":68.35,"text":"人世间平常的"},{"t":69.46,"text":"悲伤"},{"t":69.97,"text":"感动"},{"t":70.75,"text":"忐忑"},{"t":71.42,"text":"快乐"},{"t":73.05,"text":"从没有资格去体会过"},{"t":75.92,"text":"多么想去触碰你的手"},{"t":79.05,"text":"感受那份真实的温热"},{"t":83.02,"text":"而你和我之间"},{"t":84.39,"text":"相隔"},{"t":85.18,"text":"不同"},{"t":85.9,"text":"银河"},{"t":86.73,"text":"时空"},{"t":87.52,"text":"仿佛始终没有相遇过"},{"t":108.71,"text":"别再埋怨什么"},{"t":116.93,"text":"别再故意做错"},{"t":124.18,"text":"怕来不及懂得"},{"t":129.11,"text":"还没珍惜"},{"t":131.61,"text":"回头已经消失殆尽"},{"t":136.73,"text":"可我 永远不会离开"},{"t":139.97,"text":"在身边守候 十年"},{"t":145.39,"text":"一千万年以后依旧"},{"t":151.27,"text":"如果你听过我的歌"},{"t":154.54,"text":"带给你一丝丝的温柔"},{"t":158.11,"text":"就算总有一天"},{"t":159.46,"text":"没人"},{"t":160.09,"text":"记得"},{"t":160.78,"text":"我的"},{"t":161.68,"text":"名字"},{"t":162.35,"text":"也不后悔我曾经来过"},{"t":165.69,"text":"多么想停留在这一刻"},{"t":169.08,"text":"被人聆听着的这一刻"},{"t":172.9,"text":"没有人能阻挡"},{"t":173.98,"text":"时间"},{"t":174.53,"text":"向前"},{"t":175.74,"text":"流的"},{"t":176.41,"text":"长河"},{"t":177.09,"text":"只有眼前的好好把握"},{"t":195.53,"text":"多希望赐我一天就一天"},{"t":203.81,"text":"唱完这句就毁灭也无妨"},{"t":209.72,"text":"感谢你听过我的歌"},{"t":213.04,"text":"除了这些我一无所有"},{"t":216.7,"text":"人世间平常的"},{"t":218.45,"text":"悲伤"},{"t":219.11,"text":"感动"},{"t":219.75,"text":"忐忑"},{"t":220.46,"text":"快乐"},{"t":221.17,"text":"从没有资格去体会过"},{"t":224.54,"text":"多么想去触碰你的手"},{"t":227.55,"text":"感受那份真实的温热"},{"t":231.48,"text":"而你和我之间"},{"t":232.66,"text":"相隔"},{"t":233.24,"text":"不同"},{"t":233.91,"text":"银河"},{"t":234.69,"text":"时空"},{"t":235.38,"text":"仿佛始终没有相遇过"}]}