{"songId":"2010068668","title":"免费主义","lines":[{"t":15.59,"text":"准备好制造混乱（BOOM!）"},{"t":18.01,"text":"现在唤醒麻木的 感官（OLEO）"},{"t":21.96,"text":"流水线尽头那端 亿个我还在投入生产"},{"t":26.25,"text":"我像失灵的器械 不停地空转"},{"t":29.81,"text":"但并不意味着我是 笨蛋（BAKA）"},{"t":33.93,"text":"第一句 听超乎礼仪那种 调侃"},{"t":35.95,"text":"第二句 突然被天降棒槌 审判"},{"t":37.74,"text":"你设计理念 是否太超前"},{"t":39.69,"text":"没给预留半点边界感"},{"t":41.87,"text":"最后大家都一样"},{"t":43.99,"text":"同类品被打包装箱"},{"t":45.73,"text":"《物美价廉》《错过明年》"},{"t":47.77,"text":"促销标语贴在脸上"},{"t":50.21,"text":"Take a breath"},{"t":52.71,"text":"看轻蔑的眼神好像又为我降价"},{"t":57.71,"text":"Never have any time to wait"},{"t":59.83,"text":"Never have any time to wait"},{"t":61.67,"text":"被推搡摆上拥挤货架 还叫我乖乖听话"},{"t":65.62,"text":"激光热流 一霎喷发"},{"t":67.73,"text":"飞溅出玻璃雪花"},{"t":69.71,"text":"当作我在讲玩笑话"},{"t":71.55,"text":"掉以轻心了吧？"},{"t":73.42,"text":"琳琅满目 随手抛洒"},{"t":75.65,"text":"我本尊值回票价"},{"t":77.6,"text":"拆散了部件 灵魂皆白手起家"},{"t":84.66,"text":"（aHuh aHuh）"},{"t":90.15,"text":"谁趋于同化 谁衡量价码"},{"t":93.91,"text":"谁有句 *优雅*"},{"t":95.87,"text":"直抒胸臆（WAKE UP!）"},{"t":98.05,"text":"扮演 行尸走肉最让人着迷"},{"t":99.9,"text":"没想过芯片可以独立地运行"},{"t":101.84,"text":"谁的思想 根植在我的记忆体"},{"t":104.06,"text":"聒噪又利己"},{"t":104.8,"text":"随爆破声被归零"},{"t":106.34,"text":"你说什么我没听清——"},{"t":108.19,"text":"不合理的邀请"},{"t":109.77,"text":"早就该像这样 一手反弹"},{"t":111.52,"text":"自己想 自主有效降压降糖"},{"t":114.14,"text":"Now be quiet"},{"t":116.58,"text":"世界不该仅剩某一种无聊声音"},{"t":121.62,"text":"Never have any time to waste"},{"t":123.76,"text":"Never have any time to waste"},{"t":125.46,"text":"我点燃引线倒数开始 打破罐里的惯例"},{"t":129.66,"text":"镶金的蛇 吐红的信"},{"t":131.84,"text":"附加条件被隐形"},{"t":133.55,"text":"面对你伪造的神明"},{"t":135.51,"text":"猜我听是不听？"},{"t":137.35,"text":"瞬时冲击 “置换”反应"},{"t":139.55,"text":"掀翻虚掩的底气"},{"t":141.53,"text":"规则太平静 下一秒分崩离析"},{"t":147.54,"text":"欲望无度被添加"},{"t":153.32,"text":"急需重新规划"},{"t":168.84,"text":"（BOOM!）"},{"t":169.46,"text":"惊醒黑夜 炫目的爆炸"},{"t":172.01,"text":"逃亡也如此盛大"},{"t":173.48,"text":"运作一切的操盘手"},{"t":175.6,"text":"掉以轻心了吧？"},{"t":177.49,"text":"琳琅满目 随手抛洒"},{"t":179.62,"text":"我本尊值回票价"},{"t":181.51,"text":"后果会是怎样 没想太复杂"},{"t":185.45,"text":"激光热流 一霎喷发"},{"t":187.73,"text":"飞溅出玻璃雪花"},{"t":189.64,"text":"标榜自我的梦想家"},{"t":191.57,"text":"梦到结局了吗？"},{"t":193.63,"text":"不加掩饰 没法收场"},{"t":195.84,"text":"注释自由的狂妄"},{"t":197.63,"text":"重启这荒唐 余烬后才是开场"},{"t":207.92,"text":"All those goods can be free"}]}