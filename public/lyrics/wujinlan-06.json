{"songId":"2010068686","title":"怪诞集会","lines":[{"t":13.51,"text":"时钟滴答奏起 午夜送达的密信"},{"t":18.21,"text":"来址被人抹去 但请别在意"},{"t":22.92,"text":"同被月色指引 梦想家在此汇聚"},{"t":27.54,"text":"代价是成为旁人 触不到的黎明"},{"t":32.98,"text":"几抹黑影爪牙尖利"},{"t":37.38,"text":"背后张扬蝠翼无需再藏起"},{"t":42.36,"text":"灯火映衬你那格格不入面具"},{"t":47.14,"text":"怎甘心陷入囹圄"},{"t":49.76,"text":"打碎这魔镜"},{"t":52.49,"text":"In fire"},{"t":55.11,"text":"俗世的幸存者"},{"t":57.36,"text":"Be quiet"},{"t":60.09,"text":"嘲弄低语胜过喝彩"},{"t":64.85,"text":"来加入这场即兴 同类的游行"},{"t":69.35,"text":"怪才限定"},{"t":76.15,"text":"与我一起"},{"t":81.82,"text":"你所见的风景 不过是一角浮冰"},{"t":86.61,"text":"光芒滋生阴影 又何来对立"},{"t":90.96,"text":"善与恶的谜底 从来由弱者定义"},{"t":96.36,"text":"噩梦诞生于憧憬 而我来自于你"},{"t":101.54,"text":"女巫撩起鲜红裙裾"},{"t":106.07,"text":"裙下火光点亮喧嚷市集"},{"t":110.86,"text":"来宾从不屑以合群论默契"},{"t":115.6,"text":"荆棘中绽得恣意"},{"t":118.25,"text":"刺伤也不惧"},{"t":120.98,"text":"Come here"},{"t":123.7,"text":"Go and get rid of your nightmare"},{"t":128.46,"text":"毕露锋芒构筑白夜"},{"t":133.36,"text":"哂笑同恶语都视作餐后点心"},{"t":137.83,"text":"游戏继续"},{"t":143.04,"text":"Knock knock play with me"},{"t":147.57,"text":"Find and kill my sin"},{"t":152.75,"text":"接下这邀请"},{"t":157.62,"text":"狂欢到天明"},{"t":159.98,"text":"In fire"},{"t":162.91,"text":"俗世的幸存者"},{"t":164.88,"text":"Be quiet"},{"t":167.63,"text":"嘲弄低语胜过喝彩"},{"t":172.7,"text":"来成为这场即兴 同类的游行"},{"t":177.19,"text":"怪才限定"},{"t":183.45,"text":"与我一起"},{"t":193.15,"text":"怪诞游行"}]}