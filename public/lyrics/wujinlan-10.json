{"songId":"2010064369","title":"昨日之声","lines":[{"t":33.66,"text":"早已忘记一个人"},{"t":36.06,"text":"走了多久"},{"t":39.5,"text":"不想舍弃的行囊"},{"t":41.7,"text":"掩盖了伤口"},{"t":45.12,"text":"四下无人的黑暗中"},{"t":47.31,"text":"呼吸着"},{"t":49.6,"text":"捂住眼睛听见"},{"t":52.1,"text":"熟悉的歌"},{"t":55.23,"text":"习惯隐藏的懦弱"},{"t":58.32,"text":"装作不会受伤的模样"},{"t":61.2,"text":"只为再一次听见呼唤的歌"},{"t":66.44,"text":"如果"},{"t":69.35,"text":"来自昨日的声音"},{"t":72.01,"text":"溶于变化的季节中"},{"t":75.42,"text":"反射着回忆"},{"t":77.33,"text":"仍在远方"},{"t":78.7,"text":"依稀响着"},{"t":80.63,"text":"来自昨日的声音"},{"t":83.31,"text":"抚平了那些悲伤的种种"},{"t":88.8,"text":"就这样一直走"},{"t":91.08,"text":"到时间尽头"},{"t":104.25,"text":"早已忘记有多少"},{"t":106.9,"text":"聚散离合"},{"t":110.08,"text":"一起向前的脚步"},{"t":112.34,"text":"渐渐变得寂寞"},{"t":115.55,"text":"站在下一个岔路口"},{"t":118.3,"text":"默念着"},{"t":120.04,"text":"有一天要想起"},{"t":122.86,"text":"熟悉的歌"},{"t":126.03,"text":"装满手心的月光"},{"t":128.77,"text":"我已不再是一无所有"},{"t":131.86,"text":"想念的气息包围着我"},{"t":137.32,"text":"与夜风一同"},{"t":140.18,"text":"来自昨日的声音"},{"t":142.41,"text":"隐藏在静谧的夜空"},{"t":145.99,"text":"把沿途景色"},{"t":147.73,"text":"深深映在"},{"t":149.35,"text":"每个定格"},{"t":151.04,"text":"来自昨日的声音"},{"t":153.81,"text":"依旧燃烧着温柔的灯火"},{"t":159.5,"text":"用微光照亮了"},{"t":161.74,"text":"迷茫的出口"},{"t":199.21,"text":"来自昨日的声音"},{"t":201.85,"text":"依旧在我心中响彻"},{"t":205.17,"text":"即使化作尘"},{"t":206.71,"text":"即使化作风"},{"t":208.13,"text":"也还能记得"},{"t":210.32,"text":"来自昨日的声音"},{"t":212.87,"text":"穿过了陌生遥远的时空"},{"t":218.61,"text":"呼唤着你的名字"},{"t":221.8,"text":"来自昨日的声音"},{"t":224.32,"text":"走过了春夏与秋冬"},{"t":227.96,"text":"照亮了回忆"},{"t":229.65,"text":"即使褪色"},{"t":231.27,"text":"还在唱着"},{"t":233.05,"text":"来自昨日的声音"},{"t":235.55,"text":"见证了再次微笑的重逢"},{"t":241.22,"text":"在这片熟悉的天空"}]}