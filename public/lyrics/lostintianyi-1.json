 "lines": [
  {
   "t": 0,
   "text": "即使认真对待每时每刻"
  },
  {
   "t": 4.2,
   "text": "碾着愿望的车轮仍在转动"
  },
  {
   "t": 8.4,
   "text": "倒流历史的始终"
  },
  {
   "t": 12.6,
   "text": "颠覆盖棺的对错"
  },
  {
   "t": 16.8,
   "text": "回到尚且一片空白的宇宙"
  },
  {
   "t": 21,
   "text": "每天唠叨却又完全没记住的姓名"
  },
  {
   "t": 25.2,
   "text": "被归纳在过去（在过去 在过去）"
  },
  {
   "t": 29.4,
   "text": "耳濡目染被迫了解到的繁琐事情"
  },
  {
   "t": 33.6,
   "text": "一字一句勾画未来雏形"
  },
  {
   "t": 37.8,
   "text": "麦田涟漪中掷出的纸飞机"
  },
  {
   "t": 42,
   "text": "乘着风穿过水泥森林回到我怀里"
  },
  {
   "t": 46.2,
   "text": "飞快地改变又改变"
  },
  {
   "t": 50.4,
   "text": "更迭再更迭"
  },
  {
   "t": 54.6,
   "text": "撕去的日记还是那一页"
  },
  {
   "t": 58.8,
   "text": "即使认真对待每时每刻"
  },
  {
   "t": 63,
   "text": "碾着愿望的车轮仍在转动"
  },
  {
   "t": 67.2,
   "text": "倒流历史的始终"
  },
  {
   "t": 71.4,
   "text": "颠覆盖棺的对错"
  },
  {
   "t": 75.6,
   "text": "回到尚且一片空白的宇宙"
  },
  {
   "t": 79.8,
   "text": "即使将故事打碎按我的想法拼凑"
  },
  {
   "t": 84,
   "text": "新天气新目的新世纪的人们仍然在说"
  },
  {
   "t": 88.2,
   "text": "大闹一场的狼藉"
  },
  {
   "t": 92.4,
   "text": "骇俗到不可思议"
  },
  {
   "t": 96.6,
   "text": "来自8102的恶意就在这里"
  },
  {
   "t": 100.8,
   "text": "反复争议却又完全没改观的话题"
  },
  {
   "t": 105,
   "text": "很快就被忘记（被忘记 被忘记）"
  },
  {
   "t": 109.2,
   "text": "前赴后继却在指摘之下没了声息"
  },
  {
   "t": 113.4,
   "text": "凝固曾回温的一点一滴"
  },
  {
   "t": 117.6,
   "text": "林立楼宇穿梭来去的身影"
  },
  {
   "t": 121.8,
   "text": "烙印在清澈眼底深深扎根我生命"
  },
  {
   "t": 126,
   "text": "乏味地发生又重演"
  },
  {
   "t": 130.2,
   "text": "涂抹再改写"
  },
  {
   "t": 134.4,
   "text": "孤身一人沉默的辩解"
  },
  {
   "t": 138.6,
   "text": "即使认真对待每时每刻"
  },
  {
   "t": 142.8,
   "text": "碾着愿望的车轮仍在转动"
  },
  {
   "t": 147,
   "text": "逆转既定的福祸"
  },
  {
   "t": 151.2,
   "text": "重置戏剧性因果"
  },
  {
   "t": 155.4,
   "text": "苦思冥想后剧本只字未落"
  },
  {
   "t": 159.6,
   "text": "即使将成见抛下按本心所想而活"
  },
  {
   "t": 163.8,
   "text": "透过旧规矩旧思绪的囹圄能看到什么"
  },
  {
   "t": 168,
   "text": "正面教材的典型"
  },
  {
   "t": 172.2,
   "text": "矫枉过正的范例"
  },
  {
   "t": 176.4,
   "text": "来自8102的池鱼仰望天际"
  },
  {
   "t": 180.6,
   "text": "何谓正确"
  },
  {
   "t": 184.8,
   "text": "（如果）茶余饭后能够笑谈"
  },
  {
   "t": 189,
   "text": "不停呼号奔走为了理想的结果"
  },
  {
   "t": 193.2,
   "text": "结果不如人意就再次从头来过"
  },
  {
   "t": 197.4,
   "text": "不要再指责从没放弃的我"
  },
  {
   "t": 201.6,
   "text": "此时此刻若是能逃开这水复山重"
  },
  {
   "t": 205.8,
   "text": "载着愿望的车轮开始转动"
  },
  {
   "t": 210,
   "text": "抖落世纪的尘埃"
  },
  {
   "t": 214.2,
   "text": "沿途风信子初开"
  },
  {
   "t": 218.4,
   "text": "去到距地面六千光年之外"
  },
  {
   "t": 222.6,
   "text": "巨大的引力边缘一切都变得缓慢"
  },
  {
   "t": 226.8,
   "text": "8102的钟声回到耳畔"
  },
  {
   "t": 231,
   "text": "世界咫尺处变迁"
  },
  {
   "t": 235.2,
   "text": "朝向启程的零点"
  },
  {
   "t": 239.4,
   "text": "目力所及处的某一天"
  },
  {
   "t": 243.6,
   "text": "你在身边"
  }
 ]
}