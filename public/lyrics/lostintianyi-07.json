{
 "lines": [
  {
   "t": 40.11,
   "text": "州城外天河挟危山如故"
  },
  {
   "t": 42.89,
   "text": "最是形胜处 商贾往来贮足"
  },
  {
   "t": 45.85,
   "text": "此去即蛮郊绝域"
  },
  {
   "t": 47.65,
   "text": "不知葬何朝荒骨"
  },
  {
   "t": 49.25,
   "text": "春风苍凉 草木荣枯终是尘土"
  },
  {
   "t": 52.16,
   "text": "喧囂しくも御託並べ（莫要闲言碎语讲大道理）"
  },
  {
   "t": 55.3,
   "text": "然うは問屋が卸さない（在下可不吃你那套花招）"
  },
  {
   "t": 58.13,
   "text": "郷に入りては郷に従へ（既然来此何不入乡随俗）"
  },
  {
   "t": 62.32,
   "text": "道理に 白刃が交はるは朱紅色（相争之理 白刃染上的乃是朱红）"
  },
  {
   "t": 77.27,
   "text": "隙過ぐるは雲煙が如し（往事白驹过隙过眼云烟）"
  },
  {
   "t": 83.64,
   "text": "伴ふは業障 祓はるるまじく（一身孽障 管它洗清与否）"
  },
  {
   "t": 89.03,
   "text": "去路茫茫"
  },
  {
   "t": 90.37,
   "text": "三千世界 几多爱恨情长"
  },
  {
   "t": 92.67,
   "text": "孤烟郎月 几对儿女相偿"
  },
  {
   "t": 95.67,
   "text": "众生业障 换谁难舍难忘"
  },
  {
   "t": 98.8,
   "text": "挣脱不得 可是这副旧皮囊"
  },
  {
   "t": 102.1,
   "text": "参られ！（放马过来！）"
  },
  {
   "t": 105.0,
   "text": "凡塵の慰めにぞ（若是抚慰凡尘）"
  },
  {
   "t": 108.11,
   "text": "我身の贖ひに（若是赎就此身）"
  },
  {
   "t": 111.28999999999999,
   "text": "阿波礼なれど狂い咲き（徒有物悲 却有怒放）"
  },
  {
   "t": 111.5,
   "text": "黄泉は道連れをば（求黄泉路上 同行一人）"
  },
  {
   "t": 112.81,
   "text": "沧海求粟亦是狂"
  },
  {
   "t": 139.79,
   "text": "佛灯欲照尽世间荒唐皆殊途"
  },
  {
   "t": 143.03,
   "text": "我身弊袍幂篱斩"
  },
  {
   "t": 144.96,
   "text": "妄徒孽畜"
  },
  {
   "t": 146.79,
   "text": "舀瓢弱水止渴"
  },
  {
   "t": 147.81,
   "text": "窥得谁面目清楚"
  },
  {
   "t": 148.98,
   "text": "忽忽天涯客"
  },
  {
   "t": 150.74,
   "text": "哪个糊涂哪个无辜"
  },
  {
   "t": 152.41,
   "text": "徒に芳華手折れども（纵是徒折繁花）"
  },
  {
   "t": 155.54,
   "text": "遷せ身から出た錆（却是自己作孽）"
  },
  {
   "t": 157.92000000000002,
   "text": "情けは人の為ならず（人情世故 天地我心）"
  },
  {
   "t": 161.29,
   "text": "餓別に濁酒一合（饿别时不妨洒下一合浊酒）"
  },
  {
   "t": 164.79,
   "text": "八荒六合太孤独"
  },
  {
   "t": 166.04,
   "text": "狭路相逢应有所悟"
  },
  {
   "t": 170.22,
   "text": "不问汝名姓 只问先生态度"
  },
  {
   "t": 173.62,
   "text": "尘寰多苦厄 借刀剑来渡"
  },
  {
   "t": 176.18,
   "text": "lalala"
  },
  {
   "t": 178.78,
   "text": "天踈る鄙の旅路 宛て所も無く在れば（行在江湖 身不由己）"
  },
  {
   "t": 180.04,
   "text": "朝露の殞やすくも 儚き命惜しまずにしまず（贱命一条 又何足惜）"
  },
  {
   "t": 183.83,
   "text": "幻根自寂灭 须臾诛"
  },
  {
   "t": 185.58,
   "text": "纵是修罗难救住"
  },
  {
   "t": 188.35,
   "text": "尋常に！（堂堂正正！）"
  },
  {
   "t": 189.58,
   "text": "杏花雨乱 湿了红妆"
  },
  {
   "t": 201.02,
   "text": "参られ！（放马过来！）"
  },
  {
   "t": 202.06,
   "text": "往生何往"
  },
  {
   "t": 207.85,
   "text": "狂ひて散れ武夫たる者（武者殒命 亦不足惜）"
  },
  {
   "t": 214.09,
   "text": "心欲不染它物"
  },
  {
   "t": 215.79,
   "text": "飞沙从来乱目"
  },
  {
   "t": 217.22,
   "text": "青纱浊酒俱在"
  },
  {
   "t": 218.77,
   "text": "来者自由归处"
  },
  {
   "t": 220.31,
   "text": "须知这距汉地"
  },
  {
   "t": 221.87,
   "text": "不下百八十里数"
  },
  {
   "t": 224.7,
   "text": "性命由不得片刻耽误"
  },
  {
   "t": 226.79,
   "text": "いざ出遭へ 我か大敵（放马过来 吾之大敌（同侪））"
  },
  {
   "t": 230.0,
   "text": "いとしにくし 白刃を交へよ（爱恨交杂 白刃相交）"
  },
  {
   "t": 233.24,
   "text": "於迦しけれど 乱れ咲きて（纵是可笑 却有怒放）"
  },
  {
   "t": 236.26,
   "text": "冥途の手土產にぞ（唯求死得其所）"
  },
  {
   "t": 237.93,
   "text": "生死俱欢何须恕"
  }
 ]
}
