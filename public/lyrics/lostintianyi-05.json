{
 "lines": [
  {
   "t": 2.02,
   "text": "你说时光会像一盏沙漏摔裂在地"
  },
  {
   "t": 11.3,
   "text": "被风吹散之后"
  },
  {
   "t": 14.33,
   "text": "再也不提"
  },
  {
   "t": 16.16,
   "text": "那存放过梦的破碎的玻璃瓶"
  },
  {
   "t": 26.71,
   "text": "成长若是被反复求证的所谓内因"
  },
  {
   "t": 35.18,
   "text": "病毒般扩散"
  },
  {
   "t": 37.92,
   "text": "却从不可逆"
  },
  {
   "t": 41.08,
   "text": "强迫每个人在乎生存的意义"
  },
  {
   "t": 50.64,
   "text": "上一幕才呱呱坠地"
  },
  {
   "t": 53.23,
   "text": "转眼学会奔跑前进"
  },
  {
   "t": 55.94,
   "text": "不知疲倦"
  },
  {
   "t": 57.49,
   "text": "倔强的你"
  },
  {
   "t": 62.21,
   "text": "爱是怎样一种情绪"
  },
  {
   "t": 65.17,
   "text": "让人在青春里沉溺"
  },
  {
   "t": 68.03999999999999,
   "text": "亢奋焦急"
  },
  {
   "t": 69.84,
   "text": "侵占逻辑"
  },
  {
   "t": 74.7,
   "text": "你是烙印"
  },
  {
   "t": 76.87,
   "text": "在大地宣告不羁"
  },
  {
   "t": 80.47,
   "text": "向天空呐喊"
  },
  {
   "t": 82.93,
   "text": "展示茁壮的羽翼"
  },
  {
   "t": 86.03999999999999,
   "text": "在每一丛荆棘中寻觅不凋谢的美丽"
  },
  {
   "t": 97.95,
   "text": "你用冷漠"
  },
  {
   "t": 100.53999999999999,
   "text": "气市绘分庭抗礼"
  },
  {
   "t": 104.3,
   "text": "嘲讽着所有庸人自扰的议题"
  },
  {
   "t": 109.99000000000001,
   "text": "号称热情的代理"
  },
  {
   "t": 113.13,
   "text": "化身无聊的天敌"
  },
  {
   "t": 116.22999999999999,
   "text": "放肆年轻"
  },
  {
   "t": 146.72,
   "text": "你的皱纹如今爬上面具"
  },
  {
   "t": 152.36,
   "text": "遮盖逆鳞"
  },
  {
   "t": 154.56,
   "text": "耳边传来已消散的跫音"
  },
  {
   "t": 160.64,
   "text": "稀释在水泥森林那片沉默里"
  },
  {
   "t": 168.4,
   "text": "不期然的一文不名"
  },
  {
   "t": 173.21,
   "text": "原来平凡不是演习"
  },
  {
   "t": 175.95,
   "text": "洞若观火"
  },
  {
   "t": 177.36,
   "text": "却看不清自己"
  },
  {
   "t": 182.43,
   "text": "梦才开始就被惊醒"
  },
  {
   "t": 185.02,
   "text": "旭日划破夜的寂静"
  },
  {
   "t": 187.63,
   "text": "从会刺眼"
  },
  {
   "t": 189.9,
   "text": "到不关心"
  },
  {
   "t": 194.08,
   "text": "如果哪天"
  },
  {
   "t": 196.59,
   "text": "你再也无力亲吻"
  },
  {
   "t": 200.35,
   "text": "被怨恨撕咬残破的赤子之心"
  },
  {
   "t": 205.86,
   "text": "除了叹息"
  },
  {
   "t": 208.21,
   "text": "你是否还有再呐喊的权力"
  },
  {
   "t": 218.5,
   "text": "等你老去"
  },
  {
   "t": 220.99,
   "text": "世界不再记得你"
  },
  {
   "t": 224.2,
   "text": "愿你依然存留不被祝福的理性"
  },
  {
   "t": 229.84,
   "text": "来凝视每分每秒"
  },
  {
   "t": 233.16,
   "text": "像迎接末日喧嚣"
  },
  {
   "t": 236.18,
   "text": "宛如回到襁褓"
  },
  {
   "t": 242.15,
   "text": "你是谁"
  },
  {
   "t": 244.81,
   "text": "斯芬克斯的谜题"
  },
  {
   "t": 248.34,
   "text": "幻想用爱与美镶嵌人间和炼狱"
  },
  {
   "t": 254.27,
   "text": "写得出满纸成熟话语"
  },
  {
   "t": 259.77,
   "text": "却畏惧衰老来袭"
  },
  {
   "t": 266.55,
   "text": "你会领悟"
  },
  {
   "t": 268.61,
   "text": "西西弗斯的命运"
  },
  {
   "t": 271.85,
   "text": "岁月的真理"
  },
  {
   "t": 274.82,
   "text": "在前路伛偻而行"
  },
  {
   "t": 277.83,
   "text": "枯萎入泥的花朵"
  },
  {
   "t": 281.33,
   "text": "记得每一场风雨"
  },
  {
   "t": 284.15,
   "text": "曾来过"
  },
  {
   "t": 289.9,
   "text": "又远去"
  }
 ]
}
