{"songId":"2604527604","title":"化作繁星","lines":[{"t":12.76,"text":"像下坠的雨 离开乌云"},{"t":17.51,"text":"滑落不留痕迹"},{"t":22.06,"text":"像谁的声音 混入人群"},{"t":27.18,"text":"再寻不回共鸣"},{"t":31.49,"text":"像匿名的信 寄给曾经"},{"t":36.81,"text":"也等不到回应"},{"t":41.19,"text":"像某段往事 没有结局"},{"t":46.34,"text":"再也无法忆起"},{"t":50.84,"text":"我们在这偶然的世界里"},{"t":56.03,"text":"重复着黑夜黎明"},{"t":60.68,"text":"但旅途之中每段回忆"},{"t":65.59,"text":"明暗交织汇成繁星"},{"t":74.11,"text":"漫天闪烁的繁星"},{"t":78.66,"text":"伴着我独自前行"},{"t":83.73,"text":"越过光年的距离"},{"t":88.77,"text":"照亮我的眼睛"},{"t":93.21,"text":"愿化作点点繁星"},{"t":97.99,"text":"乘着夜风在人海中拥抱你"},{"t":123.14,"text":"像某部电影 写好剧情"},{"t":127.81,"text":"却被时光抹去"},{"t":132.28,"text":"像一本日历 撕去曾经"},{"t":137.39,"text":"只能停留在如今"},{"t":142.04,"text":"我们在这偶然的世界里"},{"t":147.03,"text":"重演着喜剧与悲剧"},{"t":151.85,"text":"可是 有多少相遇"},{"t":155.45,"text":"注定着分离 却残留心里"},{"t":160.93,"text":"难以忘记"},{"t":185.96,"text":"笑着 哭着"},{"t":194.81,"text":"昨日终会褪色"},{"t":203.86,"text":"望着 这道银河"},{"t":215.19,"text":"时间都停了"},{"t":233.01,"text":"漫天闪烁的繁星"},{"t":237.3,"text":"伴着我独自前行"},{"t":241.95,"text":"越过光年的距离"},{"t":247.07,"text":"照亮我的眼睛"},{"t":251.74,"text":"愿化作点点繁星"},{"t":256.71,"text":"乘着夜风在人海中拥抱你"}]}