{"songId":"3402764239","title":"绝体绝命","lines":[{"t":25.92,"text":"没有人曾体会"},{"t":27.07,"text":"没有人曾了解"},{"t":28.6,"text":"没有人曾感受 我喜与悲"},{"t":31.75,"text":"我的爱已湮灭"},{"t":33.37,"text":"无法重新构建"},{"t":34.97,"text":"只看着他路过 笑过"},{"t":37.74,"text":"不留一声抱歉"},{"t":44.66,"text":"他决绝的语言"},{"t":45.99,"text":"立誓互不相欠"},{"t":47.64,"text":"像是一出戏剧 自己导演"},{"t":50.65,"text":"我独自在后悔"},{"t":52.35,"text":"在往事里纠结"},{"t":53.9,"text":"我的心 早已"},{"t":55.44,"text":"被掏空一切"},{"t":57.62,"text":"你看不懂"},{"t":59.21,"text":"你看不见"},{"t":60.78,"text":"我悄悄流的眼泪"},{"t":63.53,"text":"在无尽深夜"},{"t":65.13,"text":"在回忆里深陷"},{"t":66.71,"text":"有个梦 在幻灭 渐渐破碎"},{"t":69.17,"text":"来来 我最亲爱的朋友"},{"t":73.04,"text":"解开我心结 心结"},{"t":75.69,"text":"让我撕开过往一页"},{"t":77.74,"text":"翻新这一切"},{"t":79.34,"text":"让那些纠结往事"},{"t":82.05,"text":"纷纷都终结"},{"t":82.95,"text":"来来 我最牵挂的朋友"},{"t":85.64,"text":"请为我牵念 牵念"},{"t":88.44,"text":"我不想让回忆复写"},{"t":90.49,"text":"无尽的繁衍"},{"t":91.92,"text":"这爱恋 我已厌倦"},{"t":94.74,"text":"请别将它救援"},{"t":108.01,"text":"往事重重浮现"},{"t":109.26,"text":"重播着一遍遍"},{"t":110.67,"text":"我缠绕在 过去"},{"t":112.46,"text":"无尽盘旋"},{"t":113.78,"text":"恨与不舍之间"},{"t":115.3,"text":"不能轻易妥协"},{"t":116.99,"text":"将那遗憾 永远"},{"t":118.85,"text":"拥在身边"},{"t":120.74,"text":"既已不想"},{"t":122.3,"text":"也已不愿"},{"t":123.88,"text":"心生疲惫与厌倦"},{"t":126.71,"text":"只有你 能够"},{"t":128.18,"text":"突破这防线"},{"t":129.86,"text":"只有你 能将一切"},{"t":131.93,"text":"都破解"},{"t":133.33,"text":"来来 我最亲爱的朋友"},{"t":136.1,"text":"解开我心结 心结"},{"t":138.87,"text":"让我撕开过往一页"},{"t":140.88,"text":"翻新这一切"},{"t":142.47,"text":"让那些纠结往事"},{"t":144.91,"text":"纷纷都终结"},{"t":146.45,"text":"来来 我最牵挂的朋友"},{"t":148.74,"text":"请为我牵念 牵念"},{"t":151.46,"text":"我不想让回忆复写"},{"t":153.26,"text":"无尽的繁衍"},{"t":154.96,"text":"这爱恋 我已厌倦"},{"t":157.7,"text":"别将它救援"},{"t":158.84,"text":"来来 我最亲爱的朋友"},{"t":161.33,"text":"解开我心结 心结"},{"t":164.12,"text":"我想要拥抱着阳光"},{"t":166.23,"text":"让它更耀眼"},{"t":168.18,"text":"我想和你去迎接"},{"t":170.46,"text":"全新的一页"},{"t":171.32,"text":"拜拜 我最牵挂的朋友"},{"t":174,"text":"请不要为我眷恋"},{