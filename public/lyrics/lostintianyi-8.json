{
 "lines": [
  {
   "t": 18.56,
   "text": "「ねえ、好きな人いるの？」なんて"
  },
  {
   "t": 25.36,
   "text": "君が問いかけてきた"
  },
  {
   "t": 31.14,
   "text": "風が吹いて髪が揺れて"
  },
  {
   "t": 37.77,
   "text": "教室の時が止まる"
  },
  {
   "t": 43.99,
   "text": "消しゴムが床に落ちて"
  },
  {
   "t": 50.48,
   "text": "すぐに拾い上げて"
  },
  {
   "t": 54.01,
   "text": "笑いながら答える"
  },
  {
   "t": 58.08,
   "text": "「いないよ」"
  },
  {
   "t": 60.68,
   "text": "ほんのちょっと嘘をついた"
  },
  {
   "t": 63.56,
   "text": "バレるのがこわくて"
  },
  {
   "t": 66.76,
   "text": "本当のことなんて言えるわけないでしょ？"
  },
  {
   "t": 73.03,
   "text": "雨の日も風の日も想い続けている人"
  },
  {
   "t": 81.42,
   "text": "目の前にいるのに"
  },
  {
   "t": 96.65,
   "text": "「ねえ、そっちこそどうなの？」って"
  },
  {
   "t": 103.19,
   "text": "私も聞きたいけど"
  },
  {
   "t": 109.17,
   "text": "君はすぐに別の話題"
  },
  {
   "t": 115.69,
   "text": "昨日のテレビの話"
  },
  {
   "t": 121.97,
   "text": "知りたくてでもこわくて"
  },
  {
   "t": 128.32,
   "text": "壊れそうなのに"
  },
  {
   "t": 132.28,
   "text": "君は無邪気に笑う"
  },
  {
   "t": 135.94,
   "text": "ズルイよ"
  },
  {
   "t": 138.51,
   "text": "ほんのちょっとベソをかいた"
  },
  {
   "t": 141.43,
   "text": "自分が情けなくて"
  },
  {
   "t": 145.08,
   "text": "近づけば近づくほど遠ざかるみたいだ"
  },
  {
   "t": 150.99,
   "text": "この胸の鼓動さえ聞こえてしまいそうなほど"
  },
  {
   "t": 159.16,
   "text": "目の前にいるのに"
  },
  {
   "t": 184.42,
   "text": "嘘つきのままでいれば"
  },
  {
   "t": 190.75,
   "text": "ずっと友達でいられるから"
  },
  {
   "t": 196.03,
   "text": "そのほうがいいよね？"
  },
  {
   "t": 203.99,
   "text": "ほんのちょっと嘘をついた"
  },
  {
   "t": 206.99,
   "text": "私の恋心"
  },
  {
   "t": 210.24,
   "text": "簡単に誤魔化せるそんなわけないでしょ？"
  },
  {
   "t": 216.33,
   "text": "雨の日も風の日も想い続けている人"
  },
  {
   "t": 227.98,
   "text": "こんなに好きなのに"
  }
 ]
}