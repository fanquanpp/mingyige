{"songId":"3402764241","title":"棱镜","lines":[{"t":10.18,"text":"白光 分散成霓虹"},{"t":14.69,"text":"或清晰 或朦胧"},{"t":19.7,"text":"泛滥在 透明的轮廓"},{"t":24.64,"text":"把纯色 支离解构"},{"t":30.64,"text":"我们 随斑驳漂游"},{"t":34.87,"text":"或沉默 或躁动"},{"t":40.07,"text":"徘徊在 棱镜的迷宫"},{"t":45.16,"text":"却渴望 找回初衷"},{"t":53.28,"text":"所有光 汇聚奔涌"},{"t":58.25,"text":"褪去了 繁杂和错综"},{"t":63.28,"text":"不刻意 为谁动容"},{"t":67.59,"text":"为谁趋同"},{"t":71.71,"text":"从未停留"},{"t":73.79,"text":"那些光 交织相融"},{"t":78.67,"text":"流淌在 无垠的夜空"},{"t":83.86,"text":"闪烁着 点亮岑寂荒原的星火"},{"t":92.32,"text":"点亮这宇宙"},{"t":114.86,"text":"旋转 将光线收拢"},{"t":118.95,"text":"不曾退缩 只是回眸"},{"t":123.81,"text":"尽管世界 是彩色幻梦"},{"t":129.24,"text":"你也不必 姹紫嫣红"},{"t":139.99,"text":"所有光 汇聚奔涌"},{"t":144.96,"text":"偏转了 喧嚣的囚笼"},{"t":150.02,"text":"跃动着 无瑕通透"},{"t":154.48,"text":"名为隽永"},{"t":158.44,"text":"定格时空"},{"t":160.35,"text":"让我们 双手紧握"},{"t":165.31,"text":"歌唱着 纯洁的赞颂"},{"t":170.72,"text":"且拥抱 最初的律动 无论始终"},{"t":179.13,"text":"回归本色的我"}]}